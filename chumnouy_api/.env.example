# Chumnouy API — environment. Copy to .env and fill in.

APP_NAME=Chumnouy API
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/chumnouy
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/chumnouy

JWT_SECRET=chumnouy-local-development-secret-change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REMEMBER_TTL_MINUTES=43200

# Console origin (Vite dev server) and the absolute API origin.
FRONTEND_URL=http://localhost:8101
CORS_ORIGINS=http://localhost:8101
API_PUBLIC_URL=http://127.0.0.1:8100

# API key prefix for integration keys (keys look like chm_live_…).
API_KEY_PREFIX=chm

# AI assistant (per-workspace settings override these env fallbacks).
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
ASSISTANT_RATE_LIMIT_PER_HOUR=60
ASSISTANT_MAX_QUESTION_CHARS=1000
ASSISTANT_MAX_HISTORY_TURNS=8
ASSISTANT_MAX_OUTPUT_TOKENS=800

# Notifyr hand-off (human-facing delivery lives in Notifyr).
NOTIFYR_API_URL=
NOTIFYR_API_KEY=

# Outbound webhooks.
WEBHOOK_TIMEOUT_SECONDS=10

# Ticket attachments: content-addressed local media store.
MEDIA_ROOT=chumnouy_api/media
MEDIA_URL_PREFIX=/media
MAX_UPLOAD_BYTES=5000000
MAX_ATTACHMENTS_PER_MESSAGE=5
